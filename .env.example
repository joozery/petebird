# Set the real LINE contact URL before publishing.
NEXT_PUBLIC_LINE_URL=
# Optional phone number shown in the contact section.
NEXT_PUBLIC_CONTACT_PHONE=

# Facebook page URL for the floating social button.
NEXT_PUBLIC_FACEBOOK_URL=

# MongoDB connection for the admin backend (see docs/admin-backend-design.md).
# Use a user scoped to readWrite on this one database only — never the server's root user.
MONGODB_URI=
MONGODB_DB_NAME=petebird

# Secret used to sign admin login JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
